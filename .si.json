{
  "plugin": "org.smartide.plugin.tcc",
  "run": "tcc -run main.c",
  "intelligence": {
    ".json": {
      "enabled": true,
      "run": "vscode-json-language-server --stdio"
    },
    ".c": {
      "enabled": false,
      "run": "clangd"
    },
    ".yml": {
      "enabled": true,
      "run": "yaml-language-server --stdio"
    }
  }
}